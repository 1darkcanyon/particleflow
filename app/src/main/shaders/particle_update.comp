#version 450

// All-float push constants for cross-platform alignment
// Canyon / NEXUS Intelligence Solutions | PHI = 1.618033988749895

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    float numParticles;
    float numTouch;
    float attract;
    float drag;
    float width;
    float height;
    float slowH;
    float slowS;
    float slowV;
    float fastH;
    float fastS;
    float fastV;
    float hueDir;
    float frameSeed;
} pc;

layout(std430, binding = 0) buffer PositionBuffer { vec2 position[]; };
layout(std430, binding = 1) buffer VelocityBuffer { vec2 velocity[]; };
layout(std430, binding = 2) buffer ColorBuffer    { vec4 color[];    };
layout(std430, binding = 3) buffer TouchBuffer    { vec2 gTouch[];   };

uint hash(uint x) {
    x += (x << 10u); x ^= (x >> 6u);
    x += (x << 3u);  x ^= (x >> 11u);
    x += (x << 15u); return x;
}
float randomFloat(inout uint seed) {
    seed = hash(seed);
    return float(seed) / 4294967296.0;
}
vec4 hsv2rgba(float h, float s, float v) {
    float h6=6.0*h; float r,g,b;
    if      (h6<1.0){r=0.0;    g=1.0-h6;b=1.0;   }
    else if (h6<2.0){r=h6-1.0; g=0.0;   b=1.0;   }
    else if (h6<3.0){r=1.0;    g=0.0;   b=3.0-h6;}
    else if (h6<4.0){r=1.0;    g=h6-3.0;b=0.0;   }
    else if (h6<5.0){r=5.0-h6; g=1.0;   b=0.0;   }
    else            {r=0.0;    g=1.0;   b=h6-5.0;}
    float c=v*s;
    return vec4(v-c*r,v-c*g,v-c*b,1.0);
}

// SACRED GEOMETRY — PHI 1.618033988749895 — Canyon / NEXUS
const float PHI        = 1.6180339887498948;
const float GOLDEN_ANG = 2.3999632297286533;

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint totalParticles = uint(pc.numParticles);
    if (index >= totalParticles) return;

    uint totalTouch = uint(pc.numTouch);
    uint seed       = uint(pc.frameSeed) + index;
    int  hueDir     = int(pc.hueDir);

    vec2 pt  = position[index];
    vec2 vel = velocity[index];
    vec2 acc = vec2(0.0, 0.0);

    for (uint i = 0u; i < totalTouch; i++) {
        vec2 touchPos = gTouch[i];
        if (touchPos.x >= 0.0) {
            vec2  diff       = touchPos - pt;
            float diffSqNorm = diff.x*diff.x + diff.y*diff.y;
            if (diffSqNorm < 0.1) {
                float theta = randomFloat(seed) * 6.28318530718;
                diff = vec2(cos(theta), sin(theta));
                diffSqNorm = 1.0;
            }
            // Original stable 1/r force — preserved from RenderScript
            acc += (pc.attract / diffSqNorm) * diff;
        }
    }

    vel += acc;
    pt  += vel;
    vel *= pc.drag;

    float sh=pc.slowH; float fh=pc.fastH;
    if      (sh<fh && hueDir==0) sh+=1.0;
    else if (sh>fh && hueDir==1) fh+=1.0;

    float spd=clamp(log(vel.x*vel.x+vel.y*vel.y+1.0)/4.5,0.0,1.0);
    float hue=(1.0-spd)*sh+spd*fh;
    if (hue>=1.0) hue-=1.0;

    position[index] = pt;
    velocity[index] = vel;
    color[index]    = hsv2rgba(hue,
        (1.0-spd)*pc.slowS+spd*pc.fastS,
        (1.0-spd)*pc.slowV+spd*pc.fastV);
}
